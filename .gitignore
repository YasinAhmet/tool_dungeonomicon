# Big .dmmod content modules are shipped separately, not in git (GitHub caps files at 100 MB).
# The modules/ folder itself and its read-me stay.
modules/*.dmmod
modules/*.dpmod

# Left behind if the app is run from here (the app's own code ships as .pyc files beside where its .py would be:
# those are part of the program)
__pycache__/
startup_error.log

# Update.exe's downloads in progress, and its old copy after it replaced itself
.update/
Update.exe.old
